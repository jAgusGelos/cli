# Web App runner supervisor environment (example, no secrets).
#
# Deploy note: the gateway reads INFISICAL_WEBAPP_RUNNER_IMAGE from its own environment (CONTRACTS.md 3.1) and sends
# it as `image` in POST /v1/runners. INFISICAL_WEBAPP_RUNNER_IMAGES is a demo-only allowlist for a locally built
# image: it MUST NOT exist in a release build, where the allowlist is the set of Infisical-published runner digests
# shipped with the gateway release.

# Unix socket shared by the supervisor and the gateway (dir 0700, socket 0600).
INFISICAL_WEBAPP_SUPERVISOR_SOCKET=/tmp/infisical-webapp/supervisor.sock

# Demo-only allowlist, comma-separated name@sha256:<image id>. Refresh after every image rebuild.
INFISICAL_WEBAPP_RUNNER_IMAGES=infisical-webapp-runner@sha256:<image id from docker image inspect>

# Gateway side: the image ref it requests. Must be one of the allowlisted refs above.
INFISICAL_WEBAPP_RUNNER_IMAGE=infisical-webapp-runner@sha256:<image id from docker image inspect>

# Admission control (default 4).
INFISICAL_WEBAPP_MAX_RUNNERS=4
